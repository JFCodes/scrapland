    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "chokidar \"src/**/*.{ts,js,vue,css,scss}\" -c \"pnpm build\" --initial",
    "build": "tsup src/index.ts --format esm,cjs --dts"
  },
  "peerDependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "drizzle-orm": "^0.45.2"
  },
  "dependencies": {
    "cron-validate": "1.4.5"
  }
}